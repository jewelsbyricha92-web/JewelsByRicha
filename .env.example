# Copy to .env and fill in. Never commit .env.

# PostgreSQL. (Named JBR_DATABASE_URL so it can't clash with a DATABASE_URL set for another project on the same machine.)
JBR_DATABASE_URL="postgresql://user:password@localhost:5432/jewelsbyricha?schema=public"

# Direct (non-pooled) connection, used by migrations. With Neon: the same host WITHOUT "-pooler" (and add &pgbouncer=true to the URL above).
# For a plain local Postgres, set it to the same value as JBR_DATABASE_URL.
JBR_DIRECT_URL="postgresql://user:password@localhost:5432/jewelsbyricha?schema=public"

# Encrypts the login cookies - at least 32 random characters.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3010"

# Admin account created by `npm run db:seed`
ADMIN_SEED_EMAIL="admin@jewelsbyricha.in"
ADMIN_SEED_PASSWORD=""
# "true" also adds sample customers and orders so the dashboard has data (local development only)
SEED_DEMO_DATA="true"

# Razorpay (leave blank locally: payments then run in a test/mock mode that is DISABLED in production)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cloudinary (leave blank locally: photos are saved to /public/uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email: OTP codes and order emails (leave blank locally: emails are printed in the server console)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Jewels by Richa <jewelsbyricha92@gmail.com>"

# Secret for the scheduled cleanup job /api/cron/expire-orders (set the same value in Vercel project settings)
CRON_SECRET=""
